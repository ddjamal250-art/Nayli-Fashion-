<Window x:Class="NayliFashion.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
        xmlns:views="clr-namespace:NayliFashion.Wpf.Views"
        xmlns:converters="clr-namespace:NayliFashion.Wpf.Converters"
        mc:Ignorable="d"
        Title="Nayli Market &amp; Fashion - نايلي ماركت وفاشن | نظام إدارة المبيعات والكراء والمخزون الشامل (ERP &amp; POS)"
        Icon="/Assets/app_icon.ico"
        Height="850" Width="1350"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBackground}">

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockScreenCommand}" />
        <KeyBinding Key="F1" Command="{Binding NavigateToPosCommand}" />
        <KeyBinding Key="F2" Command="{Binding NavigateToInventoryCommand}" />
        <KeyBinding Key="F3" Command="{Binding NavigateToRentalsCommand}" />
        <KeyBinding Key="F4" Command="{Binding NavigateToCustomersCommand}" />
        <KeyBinding Key="F5" Command="{Binding NavigateToFinanceCommand}" />
        <KeyBinding Key="F6" Command="{Binding NavigateToSettingsCommand}" />
    </Window.InputBindings>

    <!-- ربط كل ViewModel بواجهته المناسبة تلقائياً -->
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RentalsViewModel}">
            <views:RentalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- الشريط العلوي الفاخر (Top Navigation & Status Bar) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- شعار وهوية البرنامج الرسمية -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42"
                            Background="#FFFFFF"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BrushAccentGold}"
                            BorderThickness="1.5"
                            Margin="0,0,12,0"
                            Padding="3"
                            ClipToBounds="True">
                        <Image Source="/Assets/app_logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nayli Market &amp; Fashion" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveSectionTitle}" Foreground="{StaticResource BrushAccentGold}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- مؤشرات حالة الوردية والمستخدم النشط وزر قفل الشاشة -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- زر قفل الشاشة المؤقت (Break Mode) -->
                    <Button Content="🔒 قفل الشاشة (Ctrl+L)"
                            Command="{Binding LockScreenCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="34"
                            FontSize="12"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            ToolTip="قفل مؤقت للشاشة أثناء الاستراحة أو الصلاة لحماية الصندوق والبيانات" />

                    <!-- مؤشر الوردية -->
                    <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ActiveShift.ShiftNumber, TargetNullValue='لا توجد وردية مفتوحة'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- المستخدم الحالي -->
                    <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Foreground="{StaticResource BrushAccentGold}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='المسؤول'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- الجسم الرئيسي: القائمة الجانبية والشاشة المعروضة -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية (Sidebar Navigation) -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="12,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- أزرار الأقسام الرئيسية مع إشارة للاختصارات والتسمية الثنائية -->
                    <StackPanel Grid.Row="0">
                        <Button Content="🛒  نقطة البيع (POS) [F1]"
                                Command="{Binding NavigateToPosCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />

                        <Button Content="📦  إدارة المخزون (Inventory) [F2]"
                                Command="{Binding NavigateToInventoryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />

                        <Button Content="👗  كراء الأزياء والأفرشة (Rentals) [F3]"
                                Command="{Binding NavigateToRentalsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />

                        <Button Content="👥  الزبائن والكارني (Customers) [F4]"
                                Command="{Binding NavigateToCustomersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />

                        <Button Content="💰  المالية والورديات (Finance) [F5]"
                                Command="{Binding NavigateToFinanceCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />

                        <Button Content="⚙  إعدادات النظام (Settings) [F6]"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="13"
                                Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- زر تسجيل الخروج -->
                    <Button Grid.Row="1"
                            Content="🚪  تسجيل الخروج (Logout)"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource BrushDanger}"
                            HorizontalContentAlignment="Right"
                            Height="42"
                            FontSize="13" />
                </Grid>
            </Border>

            <!-- الشاشة المعروضة حالياً -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- واجهة قفل الشاشة المؤقتة (Break Lock Overlay) -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#EE111319"
              Visibility="{Binding IsScreenLocked, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccentGold}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="35,40">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="70" Height="70" Background="{StaticResource BrushCard}" CornerRadius="35" BorderBrush="{StaticResource BrushAccentGold}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="الشاشة مقفلة مؤقتاً" Foreground="{StaticResource BrushAccentGold}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="وضع الاستراحة والصلاة لحماية الصندوق والبيانات" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    
                    <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="المستخدم النشط: " Foreground="{StaticResource BrushTextMuted}" FontSize="13" />
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="كلمة المرور لفك القفل:" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,8" />
                    <PasswordBox x:Name="LockPasswordBox"
                                 PasswordChanged="LockPasswordBox_PasswordChanged"
                                 KeyDown="LockPasswordBox_KeyDown"
                                 Height="44"
                                 FontSize="16"
                                 Background="{StaticResource BrushCard}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 CaretBrush="{StaticResource BrushAccentGold}"
                                 BorderBrush="{StaticResource BrushBorder}"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 Margin="0,0,0,12" />

                    <TextBlock Text="{Binding LockErrorMessage}"
                               Foreground="{StaticResource BrushDanger}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap" />

                    <Button Content="🔓  استئناف العمل"
                            Command="{Binding UnlockScreenCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44"
                            FontSize="15"
                            Width="300"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- حاوية الإشعارات المنبثقة الراقية (Toast Notification Overlay) -->
        <Border x:Name="ToastContainer"
                Grid.RowSpan="2"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushAccentGold}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="24,12"
                Visibility="Collapsed"
                Panel.ZIndex="9999">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastIcon" Text="✓" Foreground="{StaticResource BrushSuccess}" FontSize="20" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="إشعار" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
