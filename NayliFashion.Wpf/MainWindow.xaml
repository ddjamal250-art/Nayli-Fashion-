<Window x:Class="NayliFashion.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
        xmlns:views="clr-namespace:NayliFashion.Wpf.Views"
        mc:Ignorable="d"
        Title="Nayli Fashion - نايل فاشن | نظام إدارة المبيعات والكراء والمخزون"
        Height="850" Width="1350"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBackground}">

    <!-- ربط كل ViewModel بواجهته المناسبة تلقائياً -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RentalsViewModel}">
            <views:RentalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- الشريط العلوي الفاخر (Top Navigation & Status Bar) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- شعار وهوية البرنامج -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{StaticResource BrushCard}" CornerRadius="20" BorderBrush="{StaticResource BrushAccentGold}" BorderThickness="1.5" Margin="0,0,12,0">
                        <TextBlock Text="NF" Foreground="{StaticResource BrushAccentGold}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nayli Fashion" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveSectionTitle}" Foreground="{StaticResource BrushAccentGold}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- مؤشرات حالة الوردية والمستخدم النشط -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- مؤشر الوردية -->
                    <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ActiveShift.ShiftNumber, TargetNullValue='لا توجد وردية مفتوحة'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- المستخدم الحالي -->
                    <Border Background="{StaticResource BrushCard}" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Foreground="{StaticResource BrushAccentGold}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='المسؤول'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- الجسم الرئيسي: القائمة الجانبية والشاشة المعروضة -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية (Sidebar Navigation) -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="12,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- أزرار الأقسام الرئيسية -->
                    <StackPanel Grid.Row="0">
                        <Button Content="🛒  نقطة البيع (الكاشير)"
                                Command="{Binding NavigateToPosCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />

                        <Button Content="📦  إدارة المخزون والمعايير"
                                Command="{Binding NavigateToInventoryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />

                        <Button Content="👗  نظام كراء الأزياء والأفرشة"
                                Command="{Binding NavigateToRentalsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />

                        <Button Content="👥  العملاء ودفتر الديون"
                                Command="{Binding NavigateToCustomersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />

                        <Button Content="💰  المالية والصندوق"
                                Command="{Binding NavigateToFinanceCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />

                        <Button Content="⚙  إعدادات النظام"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Right"
                                Height="45"
                                FontSize="14"
                                Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- زر تسجيل الخروج -->
                    <Button Grid.Row="1"
                            Content="🚪  تسجيل الخروج"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource BrushDanger}"
                            HorizontalContentAlignment="Right"
                            Height="42"
                            FontSize="13" />
                </Grid>
            </Border>

            <!-- الشاشة المعروضة حالياً -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
