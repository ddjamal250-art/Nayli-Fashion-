<UserControl x:Class="NayliFashion.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
             xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushBackground}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">
            
            <!-- إشعار النجاح أو الخطأ -->
            <Border Background="{StaticResource BrushSuccess}" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#141622" FontWeight="Bold" FontSize="13" />
            </Border>

            <!-- بطاقة هوية المحل والبيانات التجارية -->
            <Border Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="بيانات المحل والهوية التجارية" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم المحل:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.StoreName, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الشعار / الوصف:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.StoreSlogan, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="العنوان (الولاية / الحي):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.StoreAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="أرقام الهاتف للتواصل:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.StorePhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- البيانات الجبائية الجزائرية وحساب بريدي موب -->
            <Border Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="البيانات الجبائية الجزائرية وحساب بريدي موب" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم السجل التجاري (RC):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.CommercialRegisterRc, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الرقم التعريفي الجبائي (NIF):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.TaxNumberNif, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم التعريف الإحصائي (NIS):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.StatisticalNumberNis, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم المادة (Article):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.ArticleImposition, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="رقم حساب بريدي موب للمحل (RIP - للدفع بالـ QR على الفاتورة):" Foreground="{StaticResource BrushAccentGold}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Settings.BaridiMobRip, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="15" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- إعدادات الطابعة الحرارية ودرج النقود -->
            <Border Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إعدادات الطابعة الحرارية ودرج النقود" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عرض ورق الإيصال (ملم):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.ThermalPaperWidthMm, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,18,0,0">
                            <CheckBox Content="فتح درج النقود إلكترونياً تلقائياً بعد كل بيع"
                                      IsChecked="{Binding Settings.AutoOpenCashDrawerOnPrint}"
                                      Foreground="{StaticResource BrushTextPrimary}"
                                      FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="رسالة تذييل وصل الكاشير (أسفل التذكرة):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.ReceiptFooterMessage, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                </StackPanel>
            </Border>

            <!-- إدارة النسخ الاحتياطي التلقائي لقاعدة البيانات -->
            <Border Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="النسخ الاحتياطي التلقائي لقاعدة البيانات" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="أخذ نسخة احتياطية الآن" Command="{Binding CreateBackupNowCommand}" Style="{StaticResource PrimaryButton}" Padding="14,8" />
                    </Grid>

                    <TextBlock Text="مسار مجلد النسخ الاحتياطي:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.BackupFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                    <TextBlock Text="أحدث النسخ الاحتياطية المتوفرة على القرص:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding AvailableBackups}" Height="100" Background="{StaticResource BrushCard}" Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- زر حفظ كافة الإعدادات -->
            <Button Content="حفظ كافة الإعدادات وبيانات المحل"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Height="46"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,0,30" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
