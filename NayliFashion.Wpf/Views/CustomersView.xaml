<UserControl x:Class="NayliFashion.Wpf.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
             xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushBackground}">

    <UserControl.Resources>
        <conv:CurrencyFormatterConverter x:Key="CurrencyConverter" />
        <conv:PopularCentimesConverter x:Key="CentimesConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط العمليات وتنبيه مواعيد الفيرمون والرواتب -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="+ إضافة عميل جديد"
                            Command="{Binding OpenNewCustomerDialogCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0" />

                    <Button Content="تسديد دفعة دين [سند قبض]"
                            Command="{Binding OpenPaymentDialogCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <!-- البحث بالاسم أو اللقب أو الحي -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="16,0"
                         VerticalAlignment="Center"
                         FontSize="14" />

                <!-- تنبيه مواعيد الفيرمون -->
                <Border Grid.Column="2" Background="{StaticResource BrushCard}" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BrushAccentGold}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تنبيه الفيرمون والرواتب: " Foreground="{StaticResource BrushAccentGold}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="{Binding DueSalaryCustomers.Count, StringFormat='{}{0} عملاء مستحقة ديونهم'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي: قائمة العملاء على اليمين وكشف حساب الكارني على اليسار -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- قائمة العملاء -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="سجل العملاء والزبائن" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="اللقب / الشهرة" Binding="{Binding FamilyName}" Width="100" />
                            <DataGridTextColumn Header="الرصيد المدين" Binding="{Binding CurrentDebtDzd, Converter={StaticResource CurrencyConverter}}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- تفاصيل العميل وكشف حساب الكارني التفصيلي -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- بطاقة ملخص دين العميل -->
                    <Border Grid.Row="0" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العميل المحدد:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedCustomer.FullName}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedCustomer.PhoneNumber}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="إجمالي الدين الحالي في الكارني:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedCustomer.CurrentDebtDzd, Converter={StaticResource CurrencyConverter}}" Foreground="{StaticResource BrushDanger}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedCustomer.CurrentDebtDzd, Converter={StaticResource CentimesConverter}}" Foreground="{StaticResource BrushSuccess}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سقف الائتمان وموعد الفيرمون:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedCustomer.MaxCreditLimitDzd, StringFormat='سقف الدين: {0:N0} دج'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedCustomer.SalaryVirementDay, StringFormat='يوم الفيرمون: {0} من الشهر'}" Foreground="{StaticResource BrushAccentGold}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="كشف حركات الحساب (Relevé de compte):" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                    <!-- جدول سجل حركات الكارني -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CustomerStatement}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="125" />
                            <DataGridTextColumn Header="نوع العملية" Binding="{Binding TransactionType}" Width="150" />
                            <DataGridTextColumn Header="دين جديد (+)" Binding="{Binding DebitAmount, Converter={StaticResource CurrencyConverter}}" Width="100" />
                            <DataGridTextColumn Header="دفعة مسددة (-)" Binding="{Binding CreditAmount, Converter={StaticResource CurrencyConverter}}" Width="100" />
                            <DataGridTextColumn Header="الرصيد بعد العملية" Binding="{Binding BalanceAfter, Converter={StaticResource CurrencyConverter}}" Width="110" />
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- حوار تسجيل عميل جديد -->
        <Grid Grid.RowSpan="2"
              Background="#B0000000"
              Visibility="{Binding IsNewCustomerDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccentGold}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تسجيل عميل جديد بدفتر الديون" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الاسم الشخصي:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اللقب / العرش:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewFamilyName, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم الشهرة / المعروف به:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewNickname, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الهاتف:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="سقف الدين المسموح (دج):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewCreditLimit, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="يوم الفيرمون (الراتب):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewSalaryVirementDay, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="إلغاء" Command="{Binding OpenNewCustomerDialogCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="حفظ العميل" Command="{Binding SaveNewCustomerCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- حوار سند قبض دفعة دين -->
        <Grid Grid.RowSpan="2"
              Background="#B0000000"
              Visibility="{Binding IsPaymentDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushSuccess}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="سند قبض وتسديد دين (الكارني)" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding SelectedCustomer.FullName, StringFormat='العميل: {0}'}" Foreground="{StaticResource BrushAccentGold}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedCustomer.CurrentDebtDzd, StringFormat='إجمالي الدين الحالي: {0:N2} دج'}" Foreground="{StaticResource BrushDanger}" FontSize="14" Margin="0,0,0,14" />

                    <TextBlock Text="المبلغ المسدد نقداً (دج):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="Bold" Height="40" Margin="0,0,0,14" Foreground="{StaticResource BrushSuccess}" />

                    <TextBlock Text="ملاحظات السند:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="إلغاء" Command="{Binding OpenPaymentDialogCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="قبض وطباعة السند" Command="{Binding SaveDebtPaymentCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
