<UserControl x:Class="NayliFashion.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
             xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushBackground}">

    <UserControl.Resources>
        <conv:CurrencyFormatterConverter x:Key="CurrencyConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- شريط العمليات العلوي: إضافة منتج، البحث، والفلترة -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="+ إضافة منتج جديد"
                            Command="{Binding OpenNewProductDialogCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0" />
                    <Button Content="+ إضافة مقاس / متغير"
                            Command="{Binding OpenNewVariantDialogCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" />
                    <Button Content="+ إضافة طاقة قماش"
                            Command="{Binding OpenNewRollDialogCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <!-- البحث بالاسم -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="16,0"
                         VerticalAlignment="Center"
                         FontSize="14" />

                <!-- الفلترة بالفئة -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding FilterCategory}"
                          DisplayMemberPath="Name"
                          Height="38" />
            </Grid>
        </Border>

        <!-- المحتوى المركزي: جدول المنتجات وتفاصيل المتغيرات والبكرات -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- جدول المنتجات الرئيسية -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="دليل المنتجات والأصناف" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="الفئة" Binding="{Binding Category.Name}" Width="140" />
                            <DataGridTextColumn Header="نوع النشاط" Binding="{Binding ProductType}" Width="130" />
                            <DataGridTextColumn Header="عدد المتغيرات" Binding="{Binding Variants.Count}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- تفاصيل المقاسات، الألوان، الأسعار، والمخزون للمنتج المحدد -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedProduct.Name, StringFormat='مقاسات ونسخ: {0}'}"
                                   Foreground="{StaticResource BrushAccentGold}"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="قائمة المتغيرات المسجلة بالمخزن مع الباركود والأسعار"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedProduct.Variants}"
                              SelectedItem="{Binding SelectedVariant}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المقاس / الوصف" Binding="{Binding VariantName}" Width="*" />
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="110" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding StockQuantity, StringFormat={}{0:0.##}}" Width="65" />
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding RetailPrice, Converter={StaticResource CurrencyConverter}}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- شريط تنبيهات النواقص السفلي -->
        <Border Grid.Row="2" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="12" Margin="0,16,0,0" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ تنبيه النواقص: " Foreground="{StaticResource BrushWarning}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LowStockAlerts.Count, StringFormat='يوجد {0} أصناف أوشكت على النفاد من المخزن.'}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <!-- حوار إضافة منتج جديد منبثق -->
        <Grid Grid.RowSpan="3"
              Background="#B0000000"
              Visibility="{Binding IsNewProductDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccentGold}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة منتج رئيسي جديد" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                    <TextBlock Text="اسم المنتج (مثال: قميص الدفة سعودي قطن / فستان نايلي أصيل):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="الفئة الرئيسية:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding NewProductCategoryId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Height="38"
                              Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="إلغاء"
                                Command="{Binding OpenNewProductDialogCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" />
                        <Button Content="حفظ المنتج"
                                Command="{Binding SaveNewProductCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
