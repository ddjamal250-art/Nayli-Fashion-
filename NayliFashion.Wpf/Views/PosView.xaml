<UserControl x:Class="NayliFashion.Wpf.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
             xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushBackground}">

    <UserControl.Resources>
        <conv:CurrencyFormatterConverter x:Key="CurrencyConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- القسم الأيمن: تصفح المنتجات والفئات وشريط الباركود السريع -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- شريط البحث السريع وقارئ الباركود -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- حقل قارئ الباركود التلقائي -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="مسح الباركود السريع (قارئ الليزر أو كتابة):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox Text="{Binding ScannedBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Padding="12,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ProcessScannedBarcodeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="إضافة"
                                    Command="{Binding ProcessScannedBarcodeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="4"
                                    Padding="12,4"
                                    FontSize="12" />
                        </Grid>
                    </StackPanel>

                    <!-- حقل البحث بالاسم -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="البحث بالاسم أو الموديل:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SearchProductTerm, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="12,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- شريط الفئات (Categories Bar) -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}"
                                         GroupName="CategoriesGroup"
                                         Margin="0,0,8,0"
                                         Padding="16,8"
                                         FontSize="13"
                                         FontWeight="Medium"
                                         Cursor="Hand">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="border"
                                                            Background="{StaticResource BrushSurface}"
                                                            BorderBrush="{StaticResource BrushBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="20"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource BrushTextPrimary}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccentGold}" />
                                                            <Setter Property="TextElement.Foreground" Value="#141622" />
                                                            <Setter TargetName="border" Property="BorderThickness" Value="0" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- شبكة بطاقات المنتجات مع الصور والأسعار والمخزون -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{x:Null}"
                                    Command="{Binding DataContext.ProductCardClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Margin="0,0,12,12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="170" Height="210"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="110" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- صورة المنتج أو أيقونة بديلة -->
                                                <Border Grid.Row="0" Background="{StaticResource BrushCard}" CornerRadius="8" ClipToBounds="True">
                                                    <TextBlock Text="Nayli"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               FontSize="18"
                                                               FontWeight="Bold" />
                                                </Border>

                                                <!-- اسم المنتج -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0" />

                                                <!-- السعر ونوع المنتج -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                                    <TextBlock Text="{Binding Category.Name}"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               FontSize="11" />
                                                    <TextBlock Text="اختر المقاس"
                                                               Foreground="{StaticResource BrushAccentGold}"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- القسم الأيسر: سلة المشتريات، الحسابات، والدفع -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurface}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- رأس السلة واختيار العميل -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="العميل (زبون عابر أو بالاسم):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="FullName"
                                  Background="{StaticResource BrushCard}"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Height="36" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="مسح السلة"
                            Command="{Binding ClearCartCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,18,0,0"
                            Padding="10,6"
                            FontSize="12" />
                </Grid>

                <!-- جدول بنود سلة المشتريات -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CartItems}"
                          SelectedItem="{Binding SelectedCartItem}"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف والمقاس" Binding="{Binding VariantName}" Width="*" />
                        
                        <DataGridTemplateColumn Header="الكمية" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-"
                                                Command="{Binding DataContext.DecrementItemQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="22" Height="22" Margin="2,0" Background="{StaticResource BrushCard}" Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##}}"
                                                   Foreground="{StaticResource BrushAccentGold}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="4,0" />
                                        <Button Content="+"
                                                Command="{Binding DataContext.IncrementItemQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="22" Height="22" Margin="2,0" Background="{StaticResource BrushCard}" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="75" />
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="80" />

                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{StaticResource BrushDanger}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- أزرار القيسات السريعة للأقمشة (أمتار جاهزة) -->
                <Border Grid.Row="2" Background="{StaticResource BrushCard}" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="قيسات أقمشة سريعة: " Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="+0.5م" Command="{Binding AddFabricDecimalMetersCommand}" CommandParameter="0.5" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11" />
                        <Button Content="+1.0م" Command="{Binding AddFabricDecimalMetersCommand}" CommandParameter="1.0" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11" />
                        <Button Content="+2.5م" Command="{Binding AddFabricDecimalMetersCommand}" CommandParameter="2.5" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11" />
                        <Button Content="+3.0م" Command="{Binding AddFabricDecimalMetersCommand}" CommandParameter="3.0" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11" />
                        <Button Content="+3.5م" Command="{Binding AddFabricDecimalMetersCommand}" CommandParameter="3.5" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- الملخص المالي والمدفوع وزر التأكيد -->
                <StackPanel Grid.Row="3">
                    <!-- الإجمالي الصافي والسعر الشعبي بالسنتيم -->
                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="المبلغ الإجمالي المطلوب:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                            
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding NetTotalDzd, Converter={StaticResource CurrencyConverter}}"
                                           Foreground="{StaticResource BrushAccentGold}"
                                           FontSize="26"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding NetTotalPopularCentimes}"
                                           Foreground="{StaticResource BrushSuccess}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="10,0,0,4" />
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding NetTotalInWords}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <!-- طريقة الدفع والمبلغ المستلم -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="طريقة الدفع:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding SelectedPaymentMethod}"
                                      SelectedValuePath="Tag"
                                      Height="36">
                                <ComboBoxItem Content="نقداً (Cash دج)" Tag="{x:Static vm:PaymentMethodEnumWrapper.CashDZD}" IsSelected="True" />
                                <ComboBoxItem Content="بريدي موب (BaridiMob RIP)" Tag="{x:Static vm:PaymentMethodEnumWrapper.BaridiMobRIP}" />
                                <ComboBoxItem Content="بطاقة الذهبية / CIB" Tag="{x:Static vm:PaymentMethodEnumWrapper.BankCardTPE}" />
                                <ComboBoxItem Content="على الحساب (كريدي)" Tag="{x:Static vm:PaymentMethodEnumWrapper.CustomerDebtCarnet}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المبلغ المستلم:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Height="36"
                                     Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                    </Grid>

                    <!-- باقي الصرف / باقي الدين -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding ChangeDueDzd, StringFormat='الصرف المتبقي: {0:N0} دج'}"
                                   Foreground="{StaticResource BrushSuccess}"
                                   FontWeight="SemiBold"
                                   FontSize="13" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding RemainingDebtDzd, StringFormat='المتبقي كدين: {0:N0} دج'}"
                                   Foreground="{StaticResource BrushDanger}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   FontSize="13" />
                    </Grid>

                    <!-- زر تأكيد البيع وطباعة الفاتورة -->
                    <Button Content="تأكيد البيع وطباعة التذكرة [F12]"
                            Command="{Binding CheckoutCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            FontSize="16"
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- حوار اختيار المقاس واللون المنبثق عند الضغط على كرت المنتج -->
        <Grid Grid.ColumnSpan="2"
              Background="#B0000000"
              Visibility="{Binding IsVariantDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccentGold}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="20"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding DialogProduct.Name, StringFormat='اختر المقاس واللون لـ: {0}'}"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,16" />

                    <DataGrid ItemsSource="{Binding DialogVariants}"
                              SelectedItem="{Binding SelectedDialogVariant}"
                              Height="220"
                              Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المقاس / المتغير" Binding="{Binding VariantName}" Width="*" />
                            <DataGridTextColumn Header="اللون" Binding="{Binding ColorName}" Width="100" />
                            <DataGridTextColumn Header="المخزون" Binding="{Binding StockQuantity, StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTextColumn Header="السعر" Binding="{Binding RetailPrice, Converter={StaticResource CurrencyConverter}}" Width="90" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="إضافة"
                                                Command="{Binding DataContext.SelectVariantFromDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="6,2"
                                                FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="إلغاء وإغلاق"
                            Command="{Binding CloseVariantDialogCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right"
                            Padding="16,8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
