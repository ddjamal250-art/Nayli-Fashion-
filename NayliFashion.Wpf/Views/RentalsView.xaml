<UserControl x:Class="NayliFashion.Wpf.Views.RentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NayliFashion.Wpf.ViewModels"
             xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RentalsViewModel}"
             FlowDirection="RightToLeft"
             Background="{StaticResource BrushBackground}">

    <UserControl.Resources>
        <conv:CurrencyFormatterConverter x:Key="CurrencyConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط العمليات: زر عقد كراء جديد وتنبيه العقود المتأخرة -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="+ إنشاء عقد كراء جديد [مناسبة / عرس]"
                        Command="{Binding OpenNewRentalDialogCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,10"
                        FontSize="14" />

                <!-- مؤشر العقود المتأخرة -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="عقود متأخرة عن موعد الإرجاع: " Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                    <TextBlock Text="{Binding OverdueOrders.Count}" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" FontSize="16" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- التبويبات والمحتوى: عقود الكراء النشطة والأصول المؤجرة -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- تبويب العقود النشطة -->
            <TabItem Header="عقود الكراء الحالية النشطة" FontSize="14" FontWeight="SemiBold">
                <Border Background="{StaticResource BrushSurface}" CornerRadius="0,12,12,12" Padding="12" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding ActiveOrders}" SelectedItem="{Binding SelectedOrder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120" />
                            <DataGridTextColumn Header="الزبون المستأجر" Binding="{Binding Customer.FullName}" Width="*" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Customer.PhoneNumber}" Width="110" />
                            <DataGridTextColumn Header="تاريخ الاستلام" Binding="{Binding EventStartDate, StringFormat={}{0:yyyy-MM-dd}}" Width="105" />
                            <DataGridTextColumn Header="تاريخ الإرجاع" Binding="{Binding ExpectedReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="105" />
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingRentFeeDzd, Converter={StaticResource CurrencyConverter}}" Width="95" />
                            <DataGridTextColumn Header="الضمان" Binding="{Binding GuaranteeType}" Width="140" />

                            <DataGridTemplateColumn Header="الإجراء" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="استرجاع وتسوية"
                                                Command="{Binding DataContext.OpenReturnInspectionDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- تبويب جرد القطع والفساتين المؤجرة -->
            <TabItem Header="سجل وحالة الفساتين والبدلات والأفرشة" FontSize="14" FontWeight="SemiBold">
                <Border Background="{StaticResource BrushSurface}" CornerRadius="0,12,12,12" Padding="12" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="باركود الأصل" Binding="{Binding AssetSerialTag}" Width="120" />
                            <DataGridTextColumn Header="اسم القطعة وموديلها" Binding="{Binding ProductVariant.VariantName}" Width="*" />
                            <DataGridTextColumn Header="الحالة الحالية" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn Header="جودة القطعة" Binding="{Binding CurrentCondition}" Width="130" />
                            <DataGridTextColumn Header="مرات الكراء" Binding="{Binding TotalRentalCount}" Width="85" />
                            <DataGridTextColumn Header="المعلاق / الخزانة" Binding="{Binding StorageLocker}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- حوار إنشاء عقد كراء جديد -->
        <Grid Grid.RowSpan="2"
              Background="#B0000000"
              Visibility="{Binding IsNewRentalDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccentGold}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="عقد كراء فستان / بدلة / أفرشة مناسبات" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                    <!-- اختيار العميل -->
                    <TextBlock Text="الزبون المستأجر:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding NewOrderCustomer}"
                              DisplayMemberPath="FullName"
                              Height="36" Margin="0,0,0,12" />

                    <!-- اختيار القطعة المتاحة -->
                    <TextBlock Text="القطعة المؤجرة المتاحة:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableAssets}"
                              SelectedItem="{Binding NewOrderSelectedAsset}"
                              DisplayMemberPath="AssetSerialTag"
                              Height="36" Margin="0,0,0,12" />

                    <!-- مبالغ الكراء والعربون -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="قيمة الكراء الإجمالية (دج):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewTotalRentFee, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="العربون المدفوع (دج):" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewAdvancePaid, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <!-- وثيقة الضمان ومكان الحفظ بالخزنة -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم بطاقة التعريف البيومترية:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewGuaranteeNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مكان حفظ الوثيقة بالخزنة:" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewGuaranteeSafeLocation, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="إلغاء"
                                Command="{Binding OpenNewRentalDialogCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" />
                        <Button Content="تثبيت العقد وطباعة الوصل"
                                Command="{Binding CreateRentalOrderCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
