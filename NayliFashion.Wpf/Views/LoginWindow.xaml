<Window x:Class="NayliFashion.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:NayliFashion.Wpf.Converters"
        mc:Ignorable="d"
        Title="Nayli Market &amp; Fashion - نايلي ماركت وفاشن | تسجيل الدخول إلى النظام (ERP &amp; POS)"
        Icon="/Assets/app_icon.ico"
        Height="650" Width="1040"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- نمط أزرار لوحة اللمس للأرقام (Touch PIN Pad Button) -->
        <Style x:Key="PinPadButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCardHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C202C" />
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط بطاقة الموظف في التبديل السريع -->
        <Style x:Key="StaffCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCardHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط تبويب وضع تسجيل الدخول -->
        <Style x:Key="AuthModeTabButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- العمود الأيمن: الهوية البصرية، الساعة الحية، وأقسام المتجر -->
            <ColumnDefinition Width="380" />
            <!-- العمود الأيسر: منطقة المصادقة التفاعلية، لوحة PIN، والموظفين -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== العمود الأيمن: واجهة نايل فاشن الفاخرة ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0"
                Padding="32,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. الشعار الرسمي المعتمد والاسم التجاري -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Width="80" Height="80"
                            Background="#FFFFFF"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            BorderBrush="{StaticResource BrushAccentGold}"
                            BorderThickness="2"
                            Padding="6"
                            ClipToBounds="True">
                        <Image Source="/Assets/app_logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="Nayli Market &amp; Fashion"
                               Foreground="{StaticResource BrushAccentGold}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="نايلي ماركت وفاشن - ولاية الجلفة"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />

                    <TextBlock Text="نظام إدارة المبيعات والكراء والمخزون الشامل (ERP &amp; POS)"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- 2. بطاقات الأقسام والأنشطة -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👗" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ألبسة جاهزة وأثواب صلاة" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="أقمصة، بدلات، وڨشابية وبر الإبل" Foreground="{StaticResource BrushTextMuted}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💎" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="كراء الفساتين والبدلات" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="عقود تأجير، وثائق الضمان ومواعيد المناسبات" Foreground="{StaticResource BrushTextMuted}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌸" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="عطور، زيوت خام ومسك" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="عطور مركبة، بخور، وسواك طبيعي" Foreground="{StaticResource BrushTextMuted}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧵" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="أقمشة بالمتر وأفرشة العروس" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="أمتار عشرية، كوفريلي ولحف فاخرة" Foreground="{StaticResource BrushTextMuted}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. الساعة الرقمية الحية وضمان الأمان الخصوصي -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="16,10" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTime}"
                                       Foreground="{StaticResource BrushAccentGold}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDate}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="جلسة عمل آمنة ومحمية بالكامل"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== العمود الأيسر: منطقة المصادقة التفاعلية ==================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,28" VerticalAlignment="Center">

                <!-- العنوان الترحيبي -->
                <TextBlock Text="تسجيل الدخول إلى النظام (System Login)"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />

                <TextBlock Text="اختر حساب المستخدم وأدخل بيانات الاعتماد للمتابعة:"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="13"
                           Margin="0,0,0,14" />

                <!-- التبديل السريع للموظفين (Staff Switcher) -->
                <TextBlock Text="المستخدمون النشطون (تسجيل دخول سريع):"
                           Foreground="{StaticResource BrushAccentGold}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StaffCardButton}"
                                        Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="34" Height="34"
                                                CornerRadius="17"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{Binding RoleBadgeColor}"
                                                BorderThickness="2"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RoleDisplay}"
                                                       Foreground="{Binding RoleBadgeColor}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- أزرار التبديل بين وضع كلمة المرور ورمز PIN -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="4" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- وضع كلمة المرور -->
                        <Button Grid.Column="0"
                                Command="{Binding SwitchToPasswordModeCommand}"
                                Margin="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AuthModeTabButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinMode}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" Margin="0,0,8,0" />
                                <TextBlock Text="كلمة المرور القياسية" />
                            </StackPanel>
                        </Button>

                        <!-- وضع رمز PIN اللمسي -->
                        <Button Grid.Column="1"
                                Command="{Binding SwitchToPinModeCommand}"
                                Margin="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AuthModeTabButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔢" Margin="0,0,8,0" />
                                <TextBlock Text="رمز PIN السريع (شاشة لمس)" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- تنبيه Caps Lock -->
                <Border Background="#2B2113"
                        BorderBrush="{StaticResource BrushWarning}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsCapsLockOn, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="تنبيه: زر الحروف الكبيرة (Caps Lock) مفعل في لوحة المفاتيح!"
                                   Foreground="{StaticResource BrushWarning}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- رسالة الخطأ -->
                <Border Background="#2A1418"
                        BorderBrush="{StaticResource BrushDanger}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="❌" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource BrushDanger}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- رسالة النجاح -->
                <Border Background="#12271D"
                        BorderBrush="{StaticResource BrushSuccess}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource BrushSuccess}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ==================== 1. نموذج كلمة المرور التقليدي ==================== -->
                <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <!-- اسم المستخدم -->
                    <TextBlock Text="اسم المستخدم:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtUsername"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Input_KeyDown"
                             Height="42"
                             FontSize="14"
                             Margin="0,0,0,14" />

                    <!-- كلمة المرور مع زر العين لإظهارها وإخفائها -->
                    <TextBlock Text="كلمة المرور:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6" />
                    <Grid Height="44" Margin="0,0,0,20">
                        <!-- حقل كلمة المرور المخفية (PasswordBox) -->
                        <PasswordBox x:Name="TxtPassword"
                                     PasswordChanged="TxtPassword_PasswordChanged"
                                     KeyDown="Input_KeyDown"
                                     Background="{StaticResource BrushSurface}"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     CaretBrush="{StaticResource BrushAccentGold}"
                                     BorderBrush="{StaticResource BrushBorder}"
                                     BorderThickness="1"
                                     Padding="12,0,44,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="15"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <PasswordBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>

                        <!-- حقل كلمة المرور الظاهرة (TextBox) -->
                        <TextBox x:Name="TxtPasswordVisible"
                                 TextChanged="TxtPasswordVisible_TextChanged"
                                 KeyDown="Input_KeyDown"
                                 Background="{StaticResource BrushSurface}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 CaretBrush="{StaticResource BrushAccentGold}"
                                 BorderBrush="{StaticResource BrushBorder}"
                                 BorderThickness="1"
                                 Padding="12,0,44,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="15"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />

                        <!-- زر العين لإظهار / إخفاء كلمة السر -->
                        <Button x:Name="BtnTogglePassword"
                                Width="40" Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="3,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                ToolTip="إظهار / إخفاء كلمة المرور">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="8">
                                        <Grid>
                                            <!-- أيقونة العين المفتوحة عند الظهور -->
                                            <Path Data="M12,4.5C7,4.5,2.73,7.61,1,12c1.73,4.39,6,7.5,11,7.5s9.27-3.11,11-7.5C21.27,7.61,17,4.5,12,4.5z M12,17c-2.76,0-5-2.24-5-5s2.24-5,5-5s5,2.24,5,5S14.76,17,12,17z M12,9c-1.66,0-3,1.34-3,3s1.34,3,3,3s3-1.34,3-3S13.66,9,12,9z"
                                                  Fill="{StaticResource BrushAccentGold}"
                                                  Stretch="Uniform" Width="18" Height="18"
                                                  Visibility="{Binding DataContext.IsPasswordVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                            <!-- أيقونة العين المشطوبة عند الإخفاء -->
                                            <Path Data="M12,7c2.76,0,5,2.24,5,5c0,0.65-0.13,1.26-0.36,1.83l2.92,2.92c1.51-1.26,2.7-2.89,3.43-4.75C21.27,7.61,17,4.5,12,4.5c-1.61,0-3.14,0.36-4.52,1.01l2.69,2.69C10.74,7.43,11.35,7,12,7z M2,4.27l2.28,2.28l0.46,0.46C3.08,8.3,1.78,10.02,1,12c1.73,4.39,6,7.5,11,7.5c1.55,0,3.03-0.3,4.38-0.84l0.42,0.42L19.73,22L21,20.73L3.27,3L2,4.27z M7.53,9.8l1.55,1.55c-0.05,0.21-0.08,0.43-0.08,0.65c0,1.66,1.34,3,3,3c0.22,0,0.44-0.03,0.65-0.08l1.55,1.55c-0.67,0.33-1.41,0.53-2.2,0.53c-2.76,0-5-2.24-5-5C7,11.21,7.2,10.47,7.53,9.8z"
                                                  Fill="{StaticResource BrushTextMuted}"
                                                  Stretch="Uniform" Width="18" Height="18"
                                                  Visibility="{Binding DataContext.IsPasswordVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- زر تسجيل الدخول الرئيسي -->
                    <Button Content="تسجيل الدخول إلى النظام (Sign In) ➜"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            FontSize="15"
                            FontWeight="Bold" />
                </StackPanel>

                <!-- ==================== 2. لوحة إدخال رمز PIN السريع ==================== -->
                <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Width="320">
                    <!-- خانة مؤشر أرقام PIN -->
                    <Border Background="{StaticResource BrushSurface}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Padding="16,10"
                            Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="أدخل رمز PIN السريع:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PinMaskedDisplay}"
                                       Foreground="{StaticResource BrushAccentGold}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- شبكة أزرار اللمس 3x4 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="1" />
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="2" />
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="3" />

                        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="4" />
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="5" />
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="6" />

                        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="7" />
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="8" />
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="9" />

                        <Button Grid.Row="3" Grid.Column="0" Content="C مسح" Style="{StaticResource PinPadButton}" Foreground="{StaticResource BrushTextMuted}" FontSize="14" Command="{Binding ClearPinCommand}" />
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PinPadButton}" Command="{Binding EnterPinDigitCommand}" CommandParameter="0" />
                        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource PinPadButton}" Foreground="#F87171" FontSize="20" Command="{Binding BackspacePinCommand}" />
                    </Grid>

                    <!-- زر تأكيد دخول PIN -->
                    <Button Content="تأكيد الدخول السريع (Confirm PIN) ➜"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="46"
                            FontSize="14"
                            FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
